# Required PostgreSQL connection settings. The database stays private to Docker.
POSTGRES_USERNAME=jobs
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DATABASE=jobs
POSTGRES_PORT=5432

# Scheduler time zone; the worker runs at 08:00 and 20:00 in this zone.
APP_TIMEZONE=America/Los_Angeles
# Public board URL used by the digest's "Browse all jobs" button.
APP_PUBLIC_URL=https://jobs.example.com

# SMTP is optional during local development and required for signup and alerts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=replace-me
SMTP_FROM=New Grad Jobs <alerts@example.com>
ALERT_RECIPIENT=you@example.com
SMTP_USE_TLS=true
# Used to sign subscriber unsubscribe links. Generate a long random value.
SUBSCRIPTION_TOKEN_SECRET=replace-with-a-long-random-secret
# Keep the first import as a baseline; set true to receive the initial full digest.
SEND_INITIAL_DIGEST=false

# The worker scrapes and evaluates at most 10 new jobs per run. An API key is
# billed separately from ChatGPT plans. Leave it blank to use a persisted
# `codex login --device-auth` session instead (see README).
CODEX_API_KEY=
CODEX_MODEL=gpt-5.6-luna
CODEX_TIMEOUT_SECONDS=120
CODEX_HOME=/var/lib/codex
